# ─────────────────────────────────────────────────────────
# TMDB — Credenciales base (perfil inicial "Principal")
# ─────────────────────────────────────────────────────────
#
# En el primer arranque, si defines TMDB_READ_ACCESS_TOKEN aquí,
# se crea automáticamente un perfil llamado "Principal".
# Después puedes añadir más perfiles directamente desde la interfaz
# (ajustes → Perfiles) sin tocar este fichero.

# Método 1 ✅ RECOMENDADO: API Read Access Token (JWT)
# Obténlo en: https://www.themoviedb.org/settings/api
# → Sección "API Read Access Token" (v4 auth)
TMDB_READ_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Método 2: API Key clásica v3 + Session ID
# Solo necesario si NO usas TMDB_READ_ACCESS_TOKEN
# TMDB_API_KEY=tu_api_key_aqui
# TMDB_SESSION_ID=tu_session_id

# ID numérico de tu cuenta TMDB
# Si usas TMDB_READ_ACCESS_TOKEN puedes omitirlo (se detecta automáticamente)
# TMDB_ACCOUNT_ID=12345678

# ─────────────────────────────────────────────────────────
# Jellyfin — compartido por todos los perfiles
# ─────────────────────────────────────────────────────────
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=tu_jellyfin_api_key
# Opcional: si no se define, se usa el primer usuario disponible
# JELLYFIN_USER_ID=tu_user_id_jellyfin

# ─────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────
PORT=4895
